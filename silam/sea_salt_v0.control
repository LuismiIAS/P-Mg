#=============================================================================
# SILAM 5.9 - control file (annotated copy)
#
# Control file of the SILAM sea-salt run driven by the WRF output. Values are
# kept as run; [NOTE] comments were added.
# [NOTE] start_time and end_time belong to one yearly segment (2023). The
# years 2021 to 2024 were run with this same configuration.
# [NOTE] The emission settings are in src_sea_salt_global.ini (not included
# here): method HYBRID_AND_SPUME_WIND_10M, dynamic water temperature and
# salinity correction on (thesis, Table 7).
#=============================================================================
CONTROL_V5_3

LIST = GENERAL_PARAMETERS
case_name = CARIBE_CHEM
simulation_type = EULERIAN
direction_in_time = FORWARD
start_time = 2023 01 01 00 00 00.
end_time = 2023 12 31 18 00 00.
time_step = 20 min
# [NOTE] nbr_of_particles applies to the Lagrangian mode only (not used).
nbr_of_particles = 100
nbr_of_out_trajectories = 0
computation_accuracy = 5
END_LIST = GENERAL_PARAMETERS

LIST = MPI_PARALLEL_PARAMETERS
x_divisions = 2
y_divisions = 2
use_mpiio = YES
use_mpiio_netcdf = YES
END_LIST = MPI_PARALLEL_PARAMETERS

LIST = DISPERSION_PARAMETERS
grid_method = OUTPUT_GRID
vertical_method = OUTPUT_LEVELS
END_LIST = DISPERSION_PARAMETERS

LIST = METEO_PARAMETERS
# [NOTE] Hourly WRF output (hybrid vertical coordinate) is the only
# meteorological input; SILAM computes its own boundary-layer parameters
# from it (abl_parameterization_method = FULL_PARAM).
#static_meteo_file = NETCDF:TZ_index physiography/tz_index_02deg.nc4
dynamic_meteo_file = NETCDF:WRF_OUTPUT_HYB ${WRF_OUTPUT_DATA}/CARIBE_CHEM/wrfout_d01_%y4-%m2-%d2_%h2u00u00.nc
#static_meteo_file  = NETCDF:WRF_OUTPUT_HYB ${WRF_OUTPUT_DATA}/CARIBE_2023/wrfout_d01_%ay4-%am2-%ad2_%ah2_00_00.nc
static_meteo_file  = NETCDF:WRF_OUTPUT_HYB ${WRF_OUTPUT_DATA}/CARIBE_CHEM/wrfout_d01_%y4-%m2-%d2_%ah2u00u00.nc
# [NOTE] land_rough_met is set as a constant test field (0.01) over the grid.
static_meteo_file  = TEST_FIELD land_rough_met  SURFACE_LEVEL  0.01
#  static_meteo_file = NETCDF:WRF_OUTPUT WRF/%ay4-%am2-%ad2T%ah2:00:00/wrfout_d01_%ay4-%am2-%ad2_%ah200
#  static_meteo_file = NETCDF:canopy_height physiography/canopy_height_v1_0.nc4
#  static_meteo_file = NETCDF:c4_frac physiography/c4_frac.nc
#  static_meteo_file = NETCDF:irrigated_area physiography/irrigated_area.nc
# [NOTE] Global 1 deg sea-water salinity map used by the salinity correction
# of the sea-salt emission.
static_meteo_file = GRADS ${SILAM_NAS}/emis/sslt/salinity_map_global_1deg.fld_water_salinity.grads.super_ctl
meteo_time_step = 1 hr
max_hole_in_meteo_data = 3 hr
if_wait_for_data = NO
abl_parameterization_method = FULL_PARAM
#abl_parameterization_method = DRY_ABL
number_of_precipitation_fields = 2
use_lai = STATIC1
END_LIST = METEO_PARAMETERS

LIST = EMISSION_PARAMETERS
emission_source = EULERIAN ${SILAM_NAS}/emis/sslt/src_sea_salt_global.ini
cut_area_source_if_outside_meteo_grid = YES
if_technical_source_dump = NONE
END_LIST = EMISSION_PARAMETERS

LIST = TRANSFORMATION_PARAMETERS
# [NOTE] transformation and aerosol_dynamics are commented out: sea salt is
# transported and removed without chemistry or aerosol dynamics. The CB5/SOA
# aging rates, oh_param_method, cbm_tolerance and make_coarse_no3 below have
# no effect in this run.
#transformation = CB5_SOA EULERIAN
#aerosol_dynamics = SIMPLE EULERIAN
#aerosol_dynamics = VBS EULERIAN
dry_deposition_scheme = KS2011_TF
surface_resistance_method = STANDARD # WES2013
wet_deposition_scheme = NEW2011_SCAVENGING_FAKECLOUD
#max_scav_rate_depends_on = CAPE_AND_WIND
#max_scav_rate_wind_scaling = 0.07
#max_scav_rate_cape_scaling = 0.85
use_dynamic_albedo = YES
# [NOTE] Particle size follows the actual relative humidity (hygroscopic
# growth); default_relative_humidity is the fallback value.
if_actual_humidity_for_particle_size = YES
default_relative_humidity = 0.8
passive_ones_tracer = NO
oh_param_method = FROM_MASSMAP
cbm_tolerance = FAST
biogenic_SOA_aging_rate = 1.2E-11
anthropogenic_SOA_aging_rate = 4.0E-11
intermediate_volatility_OC_aging_rate = 4.0E-11
if_monoterpene_products = 1.0
make_coarse_no3 = sslt   0.03
#photolysis_affected_by_aod = YES
#photolysis_AOD_wavelength = 320 nm
#photolysis_affected_by_o3col = METEO
#cloud_model_for_photolysis = DETAILED_CLOUD
END_LIST = TRANSFORMATION_PARAMETERS

LIST = INITIAL_AND_BOUNDARY_CONDITIONS
# [NOTE] initialize_quantity and initialization_file are commented out in this
# copy. The SILAM hourly output is continuous across each change of year (the
# sea-salt mass in the domain does not drop at 1 January 00 UTC), so the
# yearly segments of the actual run were chained.
#initialize_quantity = concentration
#initialize_quantity = advection_moment_x
#iinitialize_quantity = advection_moment_y
#initialize_quantity = advection_moment_z
#initialize_quantity = daily_mean_temperature_2m
#initialize_quantity = temperature_2m_acc
#initialization_file = NETCDF ${SILAM_NAS}/output/%ay4%am2%ad2/CARIBE_%y4%m2%d200.nc
#initialization_file = GRADS  /mnt/d/Luismi/P-MSc/Data/SILAM/CARIBE/output/%ay4%am2%ad2/ALL_SRCS_AQ_%y4%m2%d2%h2_%y4_%m2_%d2_00.00.0.0_dump.grads.super_ctl
# [NOTE] CAMS EAC4 sea salt imposed every 3 h on the lateral and top
# boundaries (Dirichlet); see boundary_caribe_C_IFS.ini.
boundary_type = DIRICHLET
if_lateral_boundary = YES
if_top_boundary = YES
if_bottom_boundary = NO
boundary_time_step = 3 hr
boundary_header_filename = boundary_caribe_C_IFS.ini
END_LIST = INITIAL_AND_BOUNDARY_CONDITIONS

LIST = OPTICAL_DENSITY_PARAMETERS
optical_coefficients_depend_on_relative_humidity = YES
optical_coefficients_depend_on_temperature = YES
if_split_aerosol_modes = YES
if_narrow_wave_bands = YES
END_LIST = OPTICAL_DENSITY_PARAMETERS

LIST = OUTPUT_PARAMETERS
# [NOTE] Ten output layers; their tops are 25, 75, 175, 375, 775, 1525,
# 2725, 4725, 6725 and 8725 m above the surface.
# [NOTE] Output grid: regular lon-lat, 0.15 deg, 103 x 75 cells, from
# 81.25 W and 5.25 N (cell centres).
source_id = NO_SOURCE_SPLIT
vertical_method = CUSTOM_LAYERS
level_type = HEIGHT_FROM_SURFACE
layer_thickness = 25. 50. 100. 200. 400. 750. 1200. 2000. 2000. 2000.
output_time_step = 1 hr
output_times = REGULAR
output_format = NETCDF3
time_split = HOURLY_NEW_FILE
template = ${SILAM_NAS}/output/%case_%y4/CARIBE_%y4%m2%d2%h2
variable_list = output_config_co.lst
massmap_precision_factor = 128
dump_precision_factor = 128
grid_method = CUSTOM_GRID
grid_type = lon_lat
grid_title = GEMS output grid
resol_flag = 128
ifReduced = 0
earth_flag = 0
wind_component = 0
reduced_nbr_str = 0
lon_start = -81.25
lat_start = 5.25
nx = 103
dx = 0.15
ny = 75
dy = 0.15
lat_s_pole = -90.
lon_s_pole = 0.
lat_pole_stretch = 0.
lon_pole_stretch = 0.
END_LIST = OUTPUT_PARAMETERS

LIST = STANDARD_SETUP
advection_method_eulerian = EULERIAN_V5
mass_distributor = TRIANGLE_SLAB
diffuse_vert_cm = YES
grav_separation = NO
reference_4_low_mass_threshold = CONST
stomatal_conductance = HIGH
kz_profile_method = SIMPLE_KZ
advection_method_lagrangian = LAGRANGIAN_WIND_ENDPOINT_3D
random_walk_method = FULLY_MIXED
advection_method_default = EULERIAN
abl_height_method = COMBINATION
continuity_equation = anelastic_v2
wind_diagnostics = opentop
horizontal_interpolation = LINEAR
vertical_interpolation = LINEAR
time_interpolation = LINEAR
standard_setup_directory = ${SILAM_INI}
nuclide_database_fnm = ^silam_nuclides.dat
chemical_database_fnm = ^silam_chemicals_95_OC.dat
standard_cocktail_fnm = ^standard_aerosols_cocktails.ini
standard_cocktail_fnm = ^standard_chemistry_cocktails_cbm5.ini
standard_cocktail_fnm = ^standard_auxillary_cocktails.ini
standard_cocktail_fnm = ^standard_fires_cocktails.ini
standard_cocktail_fnm = ^standard_SOA_cocktails.ini
grib_name_table_fnm = ^grib_name_table.silam
netcdf_name_table_fnm = ^netcdf_name_table.silam
timezone_list_fnm = ^tzindex.dat
#photolysis_data_file = /mnt/d/Luismi/P-MSc/Data/SILAM/CARIBE/photolysis/photolysis_finrose_84rates50levs12ozones7albedos.dat
land_use_data_meta_file = ^land_use_features_USGS_Eurasia.dat
optical_properties_meta_data_file = ^optical_properties.dat
allow_zero_forecast_length = NO
precipitation_low_limit = 0.05 mm/hr
print_debug_info = DEBUG_INFO_YES
cloud_report_interval = 1
disregard_meteo_data_sources = YES
randomise_reprojection = YES
END_LIST = STANDARD_SETUP
END_CONTROL_V5_3
